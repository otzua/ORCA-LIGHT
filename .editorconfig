# EditorConfig specification for Orca Light
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cpp,h,hpp,c}]
indent_style = space
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf
indent_style = space
indent_size = 4

[*.{ini,cfg}]
end_of_line = crlf
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
